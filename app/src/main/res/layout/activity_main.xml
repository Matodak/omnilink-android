<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_background">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        android:background="@color/md_web_logo_banner_bg">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/md_web_logo_banner_bg"
            android:theme="@style/ThemeOverlay.Material3.Light"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
            app:titleCentered="true"
            app:titleTextColor="@color/md_web_header_text"
            app:subtitleTextColor="@color/md_web_subtle_text"
            app:title="@string/APP_NAME" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/md_web_border" />

    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/md_web_background"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/webLinkHeaderPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/content_padding"
            android:layout_marginTop="10dp"
            android:layout_marginRight="@dimen/content_padding"
            android:background="@color/md_web_page_header_bg"
            android:orientation="vertical"
            android:paddingLeft="8dp"
            android:paddingTop="6dp"
            android:paddingRight="8dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/webLinkPanelTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/WEBLINK_HEADER_TITLE"
                android:textColor="@color/md_on_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/webLinkPanelSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/WEBLINK_HEADER_SUBTITLE"
                android:textColor="@color/md_on_primary"
                android:textSize="11sp" />

        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/categoryTabScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/content_padding"
            android:layout_marginTop="8dp"
            android:layout_marginRight="@dimen/content_padding"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/categoryTabContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal" />

        </HorizontalScrollView>

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/content_padding"
            android:layout_marginTop="8dp"
            android:layout_marginRight="@dimen/content_padding"
            android:layout_marginBottom="4dp"
            app:dividerColor="@color/md_web_border" />

        <!-- Scrollable category content -->
        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/mainLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="@dimen/content_padding"
                android:paddingRight="@dimen/content_padding"
                android:paddingBottom="@dimen/content_padding" />

        </ScrollView>

    </LinearLayout>

    <!-- Loading overlay: full-screen dim + centred spinner -->
    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/loading_scrim"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progressIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            app:indicatorColor="@color/md_secondary"
            app:trackColor="@color/md_primary_container" />

    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
